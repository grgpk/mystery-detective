# Anthropic credentials (or run `ant auth login`; the SDK picks the profile up automatically).
ANTHROPIC_API_KEY=
# Postgres from ../docker-compose.yml. Leave unset to keep games in memory.
DATABASE_URL=postgresql://alibi:alibi@localhost:55432/last_alibi
# "scripted" plays offline with deterministic suspects (no LLM calls); default "anthropic".
LLM_MODE=anthropic
RUNS_PER_MINUTE=30
# Generated cases kept ready in the background (each costs one or more Claude Opus calls). 0 turns generation off.
CASE_POOL_SIZE=2
# Shared with the frontend (same value there). Required in production: without it anyone can call the agent.
AGENT_SHARED_SECRET=
# Per-player caps over a rolling 24 hours.
GAMES_PER_DAY=30
FRESH_CASES_PER_DAY=5
# Generated cases kept ready for each non-default theme (space station, disco, fantasy, Tbilisi). 0 turns them off.
THEMED_POOL_SIZE=1
