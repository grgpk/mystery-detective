# Anthropic credentials (or run `ant auth login`; the SDK picks the profile up automatically).
ANTHROPIC_API_KEY=
# Postgres from ../docker-compose.yml. Leave unset to keep games in memory.
DATABASE_URL=postgresql://alibi:alibi@localhost:55432/last_alibi
# "scripted" plays offline with deterministic suspects (no LLM calls); default "anthropic".
LLM_MODE=anthropic
RUNS_PER_MINUTE=30
